<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>مكتبة القرآن | Quran Library</title>
  <meta name="description" content="مكتبة القرآن الكريم، توقيت مكة، مواقيت الصلاة، تحويل التاريخ الهجري، وإذاعة القرآن الكريم. Quran resources, Makkah time, prayer times, Hijri converter, and Saudi Quran Radio.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Inter:wght@400;500;600;700;800&family=Noto+Kufi+Arabic:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link href="assets/css/master.css" rel="stylesheet">

  <style>
    :root {
      --primary: #0f2b5e;
      --primary-light: #1e4a8a;
      --green: #0f766e;
      --green-light: #10b981;
      --gold: #d8a72e;
      --surface: #ffffff;
      --background: #f5f7fb;
      --text: #172033;
      --muted: #64748b;
      --border: #e2e8f0;
      --shadow: 0 16px 40px rgba(15, 43, 94, .09);
      --radius: 20px;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      background: var(--background);
      color: var(--text);
      font-family: "Noto Kufi Arabic", "Inter", sans-serif;
      line-height: 1.7;
    }

    html[lang="en"] body {
      font-family: "Inter", sans-serif;
      line-height: 1.6;
    }

    button, input, select { font: inherit; }

    .page-shell {
      width: min(1180px, calc(100% - 32px));
      margin: 0 auto;
      padding: 28px 0 70px;
    }

    .top-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      margin-bottom: 24px;
    }

    .back-link,
    .language-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 42px;
      padding: 8px 16px;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: var(--surface);
      color: var(--primary);
      box-shadow: 0 1px 2px rgba(0, 0, 0, .05);
      font-size: .9rem;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
      transition: transform .2s ease, background .2s ease, color .2s ease;
    }

    .back-link:hover,
    .language-button:hover {
      background: var(--primary);
      color: white;
      transform: translateY(-1px);
    }

    .hero {
      position: relative;
      overflow: hidden;
      background:
        radial-gradient(circle at 88% 10%, rgba(216, 167, 46, .24), transparent 28%),
        linear-gradient(135deg, #071f45, #0f3a72 58%, #0f766e);
      color: white;
      border-radius: 28px;
      padding: 44px;
      box-shadow: var(--shadow);
      margin-bottom: 24px;
    }

    .hero::after {
      content: "۞";
      position: absolute;
      inset-inline-end: 34px;
      bottom: -58px;
      color: rgba(255, 255, 255, .08);
      font-family: "Amiri", serif;
      font-size: 12rem;
      line-height: 1;
      pointer-events: none;
    }

    .hero-kicker {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #fde68a;
      font-weight: 800;
      font-size: .85rem;
    }

    .hero h1 {
      position: relative;
      z-index: 1;
      margin: 10px 0 8px;
      font-size: clamp(2rem, 5vw, 3.6rem);
      line-height: 1.2;
    }

    .hero p {
      position: relative;
      z-index: 1;
      margin: 0;
      max-width: 790px;
      color: rgba(255, 255, 255, .84);
    }

    .grid-two {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
      margin-bottom: 24px;
    }

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 26px;
      box-shadow: var(--shadow);
    }

    .card-title {
      margin: 0 0 5px;
      color: var(--primary);
      font-size: 1.28rem;
    }

    .card-subtitle {
      margin: 0 0 20px;
      color: var(--muted);
      font-size: .92rem;
    }

    .clock {
      direction: ltr;
      display: inline-block;
      font-size: clamp(2.35rem, 7vw, 4rem);
      font-weight: 800;
      letter-spacing: -.04em;
      color: var(--primary);
      line-height: 1.05;
      font-variant-numeric: tabular-nums;
    }

    .date-line {
      margin-top: 14px;
      font-weight: 700;
    }

    .hijri-line {
      color: var(--green);
      font-family: "Amiri", serif;
      font-size: 1.4rem;
      direction: rtl;
    }

    .radio-card {
      background:
        radial-gradient(circle at 90% 10%, rgba(216, 167, 46, .22), transparent 25%),
        linear-gradient(145deg, #071d3d, #0b315f 62%, #064e3b);
      color: white;
      overflow: hidden;
    }

    .radio-card .card-title { color: white; }
    .radio-card .card-subtitle { color: rgba(255, 255, 255, .74); }

    .radio-player {
      background: rgba(255, 255, 255, .09);
      border: 1px solid rgba(255, 255, 255, .12);
      border-radius: 18px;
      padding: 20px;
    }

    .radio-header {
      display: flex;
      align-items: center;
      gap: 15px;
      margin-bottom: 14px;
    }

    .play-button {
      width: 58px;
      height: 58px;
      flex: 0 0 58px;
      border: 0;
      border-radius: 16px;
      background: var(--gold);
      color: #111827;
      font-size: 1.25rem;
      cursor: pointer;
    }

    .station-name { font-weight: 800; }
    .stream-name { color: rgba(255, 255, 255, .65); font-size: .85rem; }

    .live {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: #fca5a5;
      font-size: .74rem;
      font-weight: 800;
    }

    .live-dot {
      width: 8px;
      height: 8px;
      background: #ef4444;
      border-radius: 50%;
      animation: pulse 1.3s infinite;
    }

    @keyframes pulse {
      50% { opacity: .35; transform: scale(.8); }
    }

    audio { width: 100%; margin: 8px 0 10px; }

    .radio-status {
      min-height: 24px;
      color: rgba(255, 255, 255, .74);
      font-size: .84rem;
    }

    .share-button,
    .primary-button,
    .tab-button {
      border: 0;
      cursor: pointer;
      font-weight: 800;
      transition: transform .2s ease, opacity .2s ease;
    }

    .share-button:hover,
    .primary-button:hover,
    .tab-button:hover,
    .play-button:hover { transform: translateY(-1px); }

    .share-button {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: 12px;
      padding: 10px 14px;
      border-radius: 12px;
      color: #071d3d;
      background: white;
    }

    .prayer-banner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 18px;
      margin-bottom: 18px;
      border-radius: 16px;
      background: linear-gradient(135deg, #064e3b, #0f766e);
      color: white;
    }

    .prayer-banner small { color: rgba(255, 255, 255, .75); }

    .countdown {
      direction: ltr;
      font-size: 1.8rem;
      font-weight: 800;
      color: #fde68a;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }

    .prayer-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }

    .prayer-time {
      padding: 12px;
      border: 1px solid var(--border);
      border-radius: 13px;
      text-align: center;
      background: #f8fafc;
    }

    .prayer-time.active {
      border-color: var(--green-light);
      background: #ecfdf5;
    }

    .prayer-time span {
      display: block;
      color: var(--muted);
      font-size: .8rem;
      margin-bottom: 3px;
    }

    .prayer-time strong {
      direction: ltr;
      display: inline-block;
      color: var(--primary);
      font-variant-numeric: tabular-nums;
    }

    .converter-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 18px;
    }

    .tab-button {
      padding: 9px 14px;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: white;
      color: var(--muted);
    }

    .tab-button.active {
      background: var(--primary);
      color: white;
      border-color: var(--primary);
    }

    .converter-form { display: none; }
    .converter-form.active { display: block; }

    .date-input-label {
      margin-bottom: 10px;
      color: var(--muted);
      font-size: .82rem;
      font-weight: 700;
    }

    .form-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }

    .field label {
      display: block;
      color: var(--muted);
      font-size: .82rem;
      font-weight: 700;
      margin-bottom: 5px;
    }

    .field select {
      width: 100%;
      padding: 11px 12px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: white;
      color: var(--text);
    }

    .primary-button {
      width: 100%;
      margin-top: 14px;
      padding: 12px;
      border-radius: 12px;
      background: var(--primary);
      color: white;
    }

    .converter-result {
      min-height: 58px;
      margin-top: 14px;
      padding: 14px;
      border: 1px dashed var(--border);
      border-radius: 12px;
      background: #f8fafc;
      color: var(--primary);
      font-weight: 700;
    }

    .result-grid { display: grid; gap: 8px; }

    .result-line {
      display: grid;
      grid-template-columns: 90px 1fr;
      gap: 10px;
      align-items: start;
    }

    .result-label {
      color: var(--muted);
      font-size: .76rem;
      text-transform: uppercase;
      letter-spacing: .03em;
    }

    .result-value {
      direction: ltr;
      text-align: start;
      color: var(--primary);
      overflow-wrap: anywhere;
    }

    .section-card { margin-bottom: 24px; }

    .library-table-wrap {
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: 16px;
    }

    table {
      width: 100%;
      min-width: 760px;
      border-collapse: collapse;
      background: white;
    }

    th,
    td {
      padding: 15px 16px;
      border-bottom: 1px solid var(--border);
      text-align: start;
    }

    th {
      background: var(--primary);
      color: white;
      font-size: .84rem;
    }

    tr:last-child td { border-bottom: 0; }
    tbody tr:hover { background: #f8fafc; }

    .arabic-name {
      direction: rtl;
      font-family: "Amiri", serif;
      font-size: 1.08rem;
    }

    .open-link {
      color: var(--primary-light);
      font-weight: 800;
      text-decoration: none;
    }

    .reminder {
      text-align: center;
      background:
        radial-gradient(circle at center, rgba(16, 185, 129, .08), transparent 50%),
        white;
    }

    .ayah {
      direction: rtl;
      font-family: "Amiri", serif;
      color: var(--green);
      font-size: clamp(1.7rem, 4vw, 2.5rem);
      line-height: 1.8;
    }

    .translation { color: var(--muted); }

    .notice {
      grid-column: 1 / -1;
      padding: 10px 12px;
      border-radius: 10px;
      background: #fffbeb;
      color: #92400e;
      font-size: .82rem;
    }

    html[dir="rtl"] .back-icon { transform: rotate(180deg); }
    html[dir="rtl"] .hijri-line { text-align: right; }
    html[dir="ltr"] .hijri-line { text-align: left; }

    @media (max-width: 850px) {
      .grid-two { grid-template-columns: 1fr; }
      .hero { padding: 32px 24px; }
    }

    @media (max-width: 560px) {
      .page-shell { width: min(100% - 20px, 1180px); padding-top: 18px; }
      .top-actions { align-items: stretch; }
      .back-link, .language-button { padding-inline: 12px; }
      .card { padding: 20px; }
      .prayer-grid { grid-template-columns: repeat(2, 1fr); }
      .form-row { grid-template-columns: 1fr; }
      .prayer-banner { align-items: flex-start; flex-direction: column; }
    }
  </style>
</head>
<body>
  <div data-include="header.html"></div>
  <div data-include="nav.html"></div>

  <main class="page-shell">
    <div class="top-actions">
      <a class="back-link" href="/">
        <i class="fa-solid fa-arrow-left back-icon"></i>
        <span data-i18n="backHome">العودة للرئيسية</span>
      </a>

      <button id="languageButton" class="language-button" type="button" aria-label="Switch language">
        <i class="fa-solid fa-language"></i>
        <span id="languageButtonText">English</span>
      </button>
    </div>

    <section class="hero">
      <div class="hero-kicker">
        <i class="fa-solid fa-book-quran"></i>
        <span data-i18n="heroKicker">القرآن والأدوات الإسلامية</span>
      </div>
      <h1 data-i18n="heroTitle">مكتبة القرآن الكريم</h1>
      <p data-i18n="heroDescription">مصاحف وكتب إسلامية، توقيت مكة، مواقيت الصلاة، محول التاريخ الهجري، وإذاعة القرآن الكريم من المملكة العربية السعودية.</p>
    </section>

    <section class="grid-two">
      <article class="card">
        <h2 class="card-title" data-i18n="makkahTimeTitle">🕋 توقيت مكة المكرمة</h2>
        <p class="card-subtitle" data-i18n="makkahTimeSubtitle">الوقت المحلي الحالي والتاريخ الهجري</p>
        <div id="makkahClock" class="clock">--:--:--</div>
        <div id="gregorianDate" class="date-line">...</div>
        <div id="hijriDate" class="hijri-line">...</div>
      </article>

      <article class="card radio-card">
        <h2 class="card-title" data-i18n="radioTitle">📻 إذاعة القرآن الكريم — بث مباشر</h2>
        <p class="card-subtitle" data-i18n="radioSubtitle">استمع مجانًا إلى إذاعة القرآن الكريم من المملكة العربية السعودية على مدار الساعة.</p>

        <div class="radio-player">
          <div class="radio-header">
            <button id="playButton" class="play-button" type="button" aria-label="تشغيل إذاعة القرآن الكريم">
              <i class="fa-solid fa-play"></i>
            </button>
            <div>
              <div class="station-name" data-i18n="stationName">إذاعة القرآن الكريم السعودية</div>
              <div class="stream-name" data-i18n="streamName">البث الأول</div>
              <div class="live"><span class="live-dot"></span><span data-i18n="live">مباشر</span></div>
            </div>
          </div>

          <audio id="radioAudio" preload="none">
            <source src="https://stream.radiojar.com/0tpy1h0kxtzuv" type="audio/mpeg">
          </audio>

          <div id="radioStatus" class="radio-status" data-i18n="radioReady">اضغط تشغيل لبدء البث المباشر.</div>

          <button id="shareButton" class="share-button" type="button">
            <i class="fa-solid fa-share-nodes"></i>
            <span data-i18n="sharePage">مشاركة الصفحة</span>
          </button>
        </div>
      </article>
    </section>

    <section class="grid-two">
      <article class="card">
        <h2 class="card-title" data-i18n="prayerTitle">🕌 مواقيت الصلاة في مكة</h2>
        <p class="card-subtitle" data-i18n="prayerSubtitle">مواقيت الصلاة لهذا اليوم في مكة المكرمة</p>

        <div class="prayer-banner">
          <div>
            <small data-i18n="timeUntil">الوقت المتبقي حتى</small>
            <div id="nextPrayerName"><strong data-i18n="nextPrayer">الصلاة القادمة</strong></div>
          </div>
          <div id="prayerCountdown" class="countdown">--:--:--</div>
        </div>

        <div id="prayerGrid" class="prayer-grid"></div>
      </article>

      <article class="card">
        <h2 class="card-title" data-i18n="converterTitle">محول التاريخ الهجري</h2>
        <p class="card-subtitle" data-i18n="converterSubtitle">التحويل بين التاريخ الهجري والميلادي</p>

        <div class="converter-tabs">
          <button class="tab-button active" type="button" data-tab="gToH" data-i18n="gToHTab">ميلادي إلى هجري</button>
          <button class="tab-button" type="button" data-tab="hToG" data-i18n="hToGTab">هجري إلى ميلادي</button>
        </div>

        <form id="gToH" class="converter-form active">
          <div class="date-input-label" data-i18n="gregorianDate">التاريخ الميلادي</div>
          <div class="form-row">
            <div class="field">
              <label for="gDay" data-i18n="day">اليوم</label>
              <select id="gDay" required></select>
            </div>
            <div class="field">
              <label for="gMonth" data-i18n="month">الشهر</label>
              <select id="gMonth" required></select>
            </div>
            <div class="field">
              <label for="gYear" data-i18n="year">السنة</label>
              <select id="gYear" required></select>
            </div>
          </div>
          <button class="primary-button" type="submit" data-i18n="convertToHijri">تحويل إلى هجري</button>
        </form>

        <form id="hToG" class="converter-form">
          <div class="date-input-label" data-i18n="hijriDate">التاريخ الهجري</div>
          <div class="form-row">
            <div class="field">
              <label for="hDay" data-i18n="day">اليوم</label>
              <select id="hDay" required></select>
            </div>
            <div class="field">
              <label for="hMonth" data-i18n="month">الشهر</label>
              <select id="hMonth" required></select>
            </div>
            <div class="field">
              <label for="hYear" data-i18n="year">السنة</label>
              <select id="hYear" required></select>
            </div>
          </div>
          <button class="primary-button" type="submit" data-i18n="convertToGregorian">تحويل إلى ميلادي</button>
        </form>

        <div id="converterResult" class="converter-result" aria-live="polite" data-i18n="selectDate">اختر التاريخ ثم اضغط تحويل.</div>
      </article>
    </section>

    <section class="card section-card">
      <h2 class="card-title" data-i18n="libraryTitle">📚 القرآن والكتب الإسلامية</h2>
      <p class="card-subtitle" data-i18n="librarySubtitle">افتح ملفات القرآن الكريم والموارد الإسلامية المتاحة</p>

      <div class="library-table-wrap">
        <table>
          <thead>
            <tr>
              <th data-i18n="category">التصنيف</th>
              <th data-i18n="englishName">الاسم بالإنجليزية</th>
              <th data-i18n="arabicName">الاسم بالعربية</th>
              <th data-i18n="type">النوع</th>
              <th data-i18n="open">فتح</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td data-i18n="quranCategory">قرآن</td>
              <td>King Fahd Quran</td>
              <td class="arabic-name">مصحف الملك فهد</td>
              <td>PDF</td>
              <td><a class="open-link" href="https://drive.google.com/file/d/1jdrf6tH3LmdVEa_ACQfbq_DGrA9-Wg6E/view" target="_blank" rel="noopener" data-i18n="openPdf">فتح PDF</a></td>
            </tr>
            <tr>
              <td data-i18n="quranCategory">قرآن</td>
              <td>Medina Quran</td>
              <td class="arabic-name">مصحف المدينة النبوية</td>
              <td>PDF</td>
              <td><a class="open-link" href="https://drive.google.com/file/d/1kPqjHCB8zCrQW8U58FBsTHGl8CtWsdNg/view" target="_blank" rel="noopener" data-i18n="openPdf">فتح PDF</a></td>
            </tr>
            <tr>
              <td data-i18n="translationCategory">ترجمة</td>
              <td>The Holy Quran in All Languages</td>
              <td class="arabic-name">القرآن الكريم بجميع اللغات</td>
              <td>PDF</td>
              <td><a class="open-link" href="https://drive.google.com/file/d/1jKpGZoitlN7rCxToHq_dq1i3Dqtix1Vh/view" target="_blank" rel="noopener" data-i18n="openPdf">فتح PDF</a></td>
            </tr>
            <tr>
              <td data-i18n="hadithCategory">حديث</td>
              <td>The Nawawi Forty Hadith</td>
              <td class="arabic-name">الأربعون النووية</td>
              <td>PDF</td>
              <td><a class="open-link" href="https://drive.google.com/file/d/1mnpAvUb717sza2tqfPriTJccpLAhVP6z/view" target="_blank" rel="noopener" data-i18n="openPdf">فتح PDF</a></td>
            </tr>
            <tr>
              <td data-i18n="duaCategory">أدعية</td>
              <td>Fortress of the Muslim</td>
              <td class="arabic-name">حصن المسلم</td>
              <td>PDF</td>
              <td><a class="open-link" href="https://drive.google.com/file/d/1l0tZAXUdKzomCfjrgsbiT7O2SIJezRtz/view" target="_blank" rel="noopener" data-i18n="openPdf">فتح PDF</a></td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="card reminder">
      <div class="ayah">أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ</div>
      <div class="translation" data-i18n="ayahTranslation">ألا بذكر الله تطمئن القلوب — سورة الرعد، الآية 28</div>
    </section>
  </main>

  <div data-include="footer.html"></div>

  <button type="button" id="scrollTop" class="scroll-top" aria-label="Scroll to top">
    <i class="fas fa-arrow-up"></i>
  </button>

  <script src="assets/js/include.js"></script>
  <script src="assets/js/main.js"></script>

  <script>
    "use strict";

    const MAKKAH_TIME_ZONE = "Asia/Riyadh";
    const PRAYER_API = "https://api.aladhan.com/v1";
    const prayerKeys = ["Fajr", "Sunrise", "Dhuhr", "Asr", "Maghrib", "Isha"];

    const translations = {
      ar: {
        pageTitle: "مكتبة القرآن | Quran Library",
        backHome: "العودة للرئيسية",
        heroKicker: "القرآن والأدوات الإسلامية",
        heroTitle: "مكتبة القرآن الكريم",
        heroDescription: "مصاحف وكتب إسلامية، توقيت مكة، مواقيت الصلاة، محول التاريخ الهجري، وإذاعة القرآن الكريم من المملكة العربية السعودية.",
        makkahTimeTitle: "🕋 توقيت مكة المكرمة",
        makkahTimeSubtitle: "الوقت المحلي الحالي والتاريخ الهجري",
        radioTitle: "📻 إذاعة القرآن الكريم — بث مباشر",
        radioSubtitle: "استمع مجانًا إلى إذاعة القرآن الكريم من المملكة العربية السعودية على مدار الساعة.",
        stationName: "إذاعة القرآن الكريم السعودية",
        streamName: "البث الأول",
        live: "مباشر",
        radioReady: "اضغط تشغيل لبدء البث المباشر.",
        sharePage: "مشاركة الصفحة",
        prayerTitle: "🕌 مواقيت الصلاة في مكة",
        prayerSubtitle: "مواقيت الصلاة لهذا اليوم في مكة المكرمة",
        timeUntil: "الوقت المتبقي حتى",
        nextPrayer: "الصلاة القادمة",
        converterTitle: "محول التاريخ الهجري",
        converterSubtitle: "التحويل بين التاريخ الهجري والميلادي",
        gToHTab: "ميلادي إلى هجري",
        hToGTab: "هجري إلى ميلادي",
        gregorianDate: "التاريخ الميلادي",
        hijriDate: "التاريخ الهجري",
        day: "اليوم",
        month: "الشهر",
        year: "السنة",
        convertToHijri: "تحويل إلى هجري",
        convertToGregorian: "تحويل إلى ميلادي",
        selectDate: "اختر التاريخ ثم اضغط تحويل.",
        libraryTitle: "📚 القرآن والكتب الإسلامية",
        librarySubtitle: "افتح ملفات القرآن الكريم والموارد الإسلامية المتاحة",
        category: "التصنيف",
        englishName: "الاسم بالإنجليزية",
        arabicName: "الاسم بالعربية",
        type: "النوع",
        open: "فتح",
        quranCategory: "قرآن",
        translationCategory: "ترجمة",
        hadithCategory: "حديث",
        duaCategory: "أدعية",
        openPdf: "فتح PDF",
        ayahTranslation: "ألا بذكر الله تطمئن القلوب — سورة الرعد، الآية 28",
        number: "رقم",
        text: "نص",
        converting: "جارٍ التحويل...",
        conversionUnavailable: "خدمة التحويل غير متاحة حاليًا. حاول مرة أخرى لاحقًا.",
        invalidHijri: "خدمة التحويل غير متاحة. تحقق من التاريخ الهجري.",
        prayerUnavailable: "تعذر تحميل مواقيت الصلاة.",
        connecting: "جارٍ الاتصال بالبث المباشر...",
        playing: "إذاعة القرآن الكريم تعمل الآن.",
        paused: "تم إيقاف الإذاعة مؤقتًا.",
        buffering: "جارٍ تحميل البث المباشر...",
        streamUnavailable: "البث المباشر غير متاح أو محظور بواسطة المتصفح.",
        copied: "تم نسخ رابط الصفحة.",
        shareFailed: "تعذرت مشاركة رابط الصفحة.",
        playAria: "تشغيل إذاعة القرآن الكريم",
        pauseAria: "إيقاف إذاعة القرآن الكريم مؤقتًا",
        shareTitle: "إذاعة القرآن الكريم — بث مباشر",
        shareText: "استمع إلى إذاعة القرآن الكريم السعودية مباشرة على مدار الساعة.",
        prayers: {
          Fajr: "الفجر",
          Sunrise: "الشروق",
          Dhuhr: "الظهر",
          Asr: "العصر",
          Maghrib: "المغرب",
          Isha: "العشاء"
        },
        gregorianMonths: ["يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو", "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر"],
        hijriMonths: ["محرم", "صفر", "ربيع الأول", "ربيع الآخر", "جمادى الأولى", "جمادى الآخرة", "رجب", "شعبان", "رمضان", "شوال", "ذو القعدة", "ذو الحجة"]
      },
      en: {
        pageTitle: "Quran Library | Mohammed Alotaibi",
        backHome: "Back to Home",
        heroKicker: "Quran & Islamic Tools",
        heroTitle: "Quran Library",
        heroDescription: "Quran PDFs, Islamic books, Makkah time, prayer times, Hijri date tools, and Saudi Quran Radio.",
        makkahTimeTitle: "🕋 Makkah Time",
        makkahTimeSubtitle: "Current local time and Hijri date",
        radioTitle: "📻 Saudi Quran Radio — Live Stream",
        radioSubtitle: "Listen free to Quran Radio from the Kingdom of Saudi Arabia, 24/7.",
        stationName: "Saudi Quran Radio",
        streamName: "Stream 1",
        live: "LIVE",
        radioReady: "Press Play to start the live stream.",
        sharePage: "Share this page",
        prayerTitle: "🕌 Makkah Prayer Times",
        prayerSubtitle: "Today's prayer schedule for Makkah",
        timeUntil: "Time until",
        nextPrayer: "Next prayer",
        converterTitle: "Hijri Date Converter",
        converterSubtitle: "Convert between Hijri and Gregorian dates",
        gToHTab: "Gregorian to Hijri",
        hToGTab: "Hijri to Gregorian",
        gregorianDate: "Gregorian date",
        hijriDate: "Hijri date",
        day: "Day",
        month: "Month",
        year: "Year",
        convertToHijri: "Convert to Hijri",
        convertToGregorian: "Convert to Gregorian",
        selectDate: "Select a date and press Convert.",
        libraryTitle: "📚 Quran & Islamic Books",
        librarySubtitle: "Open the available Quran PDFs and Islamic resources",
        category: "Category",
        englishName: "English Name",
        arabicName: "Arabic Name",
        type: "Type",
        open: "Open",
        quranCategory: "Quran",
        translationCategory: "Translation",
        hadithCategory: "Hadith",
        duaCategory: "Dua",
        openPdf: "Open PDF",
        ayahTranslation: "Verily, in the remembrance of Allah do hearts find rest. (Quran 13:28)",
        number: "Number",
        text: "Text",
        converting: "Converting...",
        conversionUnavailable: "Conversion is currently unavailable. Please try again later.",
        invalidHijri: "Conversion is unavailable. Please verify the Hijri date.",
        prayerUnavailable: "Prayer times could not be loaded.",
        connecting: "Connecting to the live stream...",
        playing: "Saudi Quran Radio is playing live.",
        paused: "Radio paused.",
        buffering: "Buffering the live stream...",
        streamUnavailable: "The live stream is unavailable or blocked by the browser.",
        copied: "Page link copied to the clipboard.",
        shareFailed: "The page link could not be shared.",
        playAria: "Play Saudi Quran Radio",
        pauseAria: "Pause Saudi Quran Radio",
        shareTitle: "Saudi Quran Radio — Live Stream",
        shareText: "Listen to Saudi Quran Radio live, 24/7.",
        prayers: {
          Fajr: "Fajr",
          Sunrise: "Sunrise",
          Dhuhr: "Dhuhr",
          Asr: "Asr",
          Maghrib: "Maghrib",
          Isha: "Isha"
        },
        gregorianMonths: ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"],
        hijriMonths: ["Muharram", "Safar", "Rabi Al-Awwal", "Rabi Al-Thani", "Jumada Al-Awwal", "Jumada Al-Thani", "Rajab", "Shaban", "Ramadan", "Shawwal", "Dhul Qidah", "Dhul Hijjah"]
      }
    };

    let currentLanguage = localStorage.getItem("quranLanguage") === "en" ? "en" : "ar";
    let prayerSchedule = [];
    let countdownTimer = null;
    let lastConverterState = "select";

    function t(key) {
      return translations[currentLanguage][key] ?? key;
    }

    function makkahDateParts() {
      const parts = new Intl.DateTimeFormat("en-CA", {
        timeZone: MAKKAH_TIME_ZONE,
        year: "numeric",
        month: "2-digit",
        day: "2-digit"
      }).formatToParts(new Date());

      const value = {};
      parts.forEach(part => {
        if (part.type !== "literal") value[part.type] = part.value;
      });
      return value;
    }

    function updateMakkahClock() {
      const now = new Date();
      const locale = currentLanguage === "ar" ? "ar-SA" : "en-GB";

      document.getElementById("makkahClock").textContent =
        new Intl.DateTimeFormat("en-GB", {
          timeZone: MAKKAH_TIME_ZONE,
          hour: "2-digit",
          minute: "2-digit",
          second: "2-digit",
          hour12: false
        }).format(now);

      document.getElementById("gregorianDate").textContent =
        new Intl.DateTimeFormat(locale, {
          timeZone: MAKKAH_TIME_ZONE,
          weekday: "long",
          day: "numeric",
          month: "long",
          year: "numeric"
        }).format(now);

      try {
        document.getElementById("hijriDate").textContent =
          new Intl.DateTimeFormat(`${locale}-u-ca-islamic-umalqura`, {
            timeZone: MAKKAH_TIME_ZONE,
            weekday: "long",
            day: "numeric",
            month: "long",
            year: "numeric"
          }).format(now);
      } catch (error) {
        document.getElementById("hijriDate").textContent = currentLanguage === "ar"
          ? "التاريخ الهجري غير مدعوم في هذا المتصفح."
          : "Hijri date is not supported by this browser.";
      }
    }

    function cleanTime(value) {
      return String(value || "").split(" ")[0];
    }

    function todayInMakkahAt(time) {
      const { year, month, day } = makkahDateParts();
      return new Date(`${year}-${month}-${day}T${time}:00+03:00`);
    }

    function renderPrayerGrid() {
      const grid = document.getElementById("prayerGrid");

      if (!prayerSchedule.length) {
        grid.innerHTML = prayerKeys.map(name => `
          <div class="prayer-time" data-prayer="${name}">
            <span>${translations[currentLanguage].prayers[name]}</span>
            <strong>--:--</strong>
          </div>
        `).join("");
        return;
      }

      grid.innerHTML = prayerSchedule.map(item => `
        <div class="prayer-time" data-prayer="${item.name}">
          <span>${translations[currentLanguage].prayers[item.name]}</span>
          <strong>${item.time}</strong>
        </div>
      `).join("");
    }

    async function loadPrayerTimes() {
      try {
        const response = await fetch(`${PRAYER_API}/timingsByCity?city=Makkah&country=Saudi%20Arabia&method=4`);
        if (!response.ok) throw new Error(`Prayer API returned ${response.status}`);

        const payload = await response.json();
        const timings = payload.data.timings;

        prayerSchedule = prayerKeys.map(name => ({
          name,
          time: cleanTime(timings[name]),
          date: todayInMakkahAt(cleanTime(timings[name]))
        }));

        renderPrayerGrid();
        updatePrayerCountdown();
        clearInterval(countdownTimer);
        countdownTimer = setInterval(updatePrayerCountdown, 1000);
      } catch (error) {
        console.error(error);
        document.getElementById("nextPrayerName").innerHTML = `<strong>${t("prayerUnavailable")}</strong>`;
        document.getElementById("prayerCountdown").textContent = "--:--:--";
        document.getElementById("prayerGrid").innerHTML = `<div class="notice">${t("prayerUnavailable")}</div>`;
      }
    }

    function updatePrayerCountdown() {
      if (!prayerSchedule.length) return;

      const now = new Date();
      let nextIndex = prayerSchedule.findIndex(item => item.date > now);
      let nextPrayer;

      if (nextIndex === -1) {
        nextPrayer = {
          name: "Fajr",
          date: new Date(prayerSchedule[0].date.getTime() + 24 * 60 * 60 * 1000)
        };
      } else {
        nextPrayer = prayerSchedule[nextIndex];
      }

      const remaining = Math.max(0, nextPrayer.date - now);
      const hours = Math.floor(remaining / 3600000);
      const minutes = Math.floor((remaining % 3600000) / 60000);
      const seconds = Math.floor((remaining % 60000) / 1000);

      document.getElementById("nextPrayerName").innerHTML =
        `<strong>${translations[currentLanguage].prayers[nextPrayer.name]}</strong>`;

      document.getElementById("prayerCountdown").textContent =
        [hours, minutes, seconds].map(value => String(value).padStart(2, "0")).join(":");

      document.querySelectorAll(".prayer-time").forEach(card => {
        card.classList.toggle("active", card.dataset.prayer === nextPrayer.name);
      });
    }

    function pad2(value) {
      return String(value).padStart(2, "0");
    }

    function fillNumberSelect(selectId, start, end, selectedValue) {
      const select = document.getElementById(selectId);
      select.innerHTML = "";

      for (let value = start; value <= end; value += 1) {
        const option = document.createElement("option");
        option.value = String(value);
        option.textContent = String(value);
        option.selected = value === Number(selectedValue);
        select.appendChild(option);
      }
    }

    function fillMonthSelect(selectId, months, selectedValue) {
      const select = document.getElementById(selectId);
      select.innerHTML = "";

      months.forEach((month, index) => {
        const option = document.createElement("option");
        option.value = String(index + 1);
        option.textContent = `${pad2(index + 1)} - ${month}`;
        option.selected = index + 1 === Number(selectedValue);
        select.appendChild(option);
      });
    }

    function refreshMonthNames() {
      const gMonth = Number(document.getElementById("gMonth").value || 1);
      const hMonth = Number(document.getElementById("hMonth").value || 1);
      fillMonthSelect("gMonth", translations[currentLanguage].gregorianMonths, gMonth);
      fillMonthSelect("hMonth", translations[currentLanguage].hijriMonths, hMonth);
    }

    function daysInGregorianMonth(year, month) {
      return new Date(Number(year), Number(month), 0).getDate();
    }

    function refreshGregorianDays() {
      const year = document.getElementById("gYear").value;
      const month = document.getElementById("gMonth").value;
      const currentDay = Number(document.getElementById("gDay").value || 1);
      const maximumDay = daysInGregorianMonth(year, month);
      fillNumberSelect("gDay", 1, maximumDay, Math.min(currentDay, maximumDay));
    }

    function renderConversionResult(numberValue, textValue) {
      lastConverterState = "result";
      document.getElementById("converterResult").innerHTML = `
        <div class="result-grid">
          <div class="result-line">
            <span class="result-label">${t("number")}</span>
            <strong class="result-value">${numberValue}</strong>
          </div>
          <div class="result-line">
            <span class="result-label">${t("text")}</span>
            <strong class="result-value">${textValue}</strong>
          </div>
        </div>
      `;
    }

    async function convertGregorianToHijri(day, month, year) {
      const response = await fetch(`${PRAYER_API}/gToH/${day}-${month}-${year}`);
      if (!response.ok) throw new Error("Gregorian conversion failed.");

      const payload = await response.json();
      const hijri = payload.data.hijri;
      const text = currentLanguage === "ar"
        ? `${hijri.weekday.ar || hijri.weekday.en}، ${hijri.day} ${hijri.month.ar || hijri.month.en} ${hijri.year} هـ`
        : `${hijri.weekday.en}, ${hijri.day} ${hijri.month.en} ${hijri.year} AH`;

      return {
        number: `${pad2(hijri.day)}-${pad2(hijri.month.number)}-${hijri.year} AH`,
        text
      };
    }

    async function convertHijriToGregorian(day, month, year) {
      const response = await fetch(`${PRAYER_API}/hToG/${day}-${month}-${year}`);
      if (!response.ok) throw new Error("Hijri conversion failed.");

      const payload = await response.json();
      const gregorian = payload.data.gregorian;
      const text = currentLanguage === "ar"
        ? `${gregorian.weekday.ar || gregorian.weekday.en}، ${gregorian.day} ${gregorian.month.ar || gregorian.month.en} ${gregorian.year}`
        : `${gregorian.weekday.en}, ${gregorian.day} ${gregorian.month.en} ${gregorian.year}`;

      return {
        number: `${pad2(gregorian.day)}-${pad2(gregorian.month.number)}-${gregorian.year}`,
        text
      };
    }

    function applyLanguage(language) {
      currentLanguage = language;
      localStorage.setItem("quranLanguage", language);

      document.documentElement.lang = language;
      document.documentElement.dir = language === "ar" ? "rtl" : "ltr";
      document.title = t("pageTitle");
      document.getElementById("languageButtonText").textContent = language === "ar" ? "English" : "العربية";

      document.querySelectorAll("[data-i18n]").forEach(element => {
        const key = element.dataset.i18n;
        if (translations[language][key]) element.textContent = translations[language][key];
      });

      refreshMonthNames();
      renderPrayerGrid();
      updatePrayerCountdown();
      updateMakkahClock();

      playButton.setAttribute("aria-label", radioAudio.paused ? t("playAria") : t("pauseAria"));

      if (lastConverterState === "select") {
        document.getElementById("converterResult").textContent = t("selectDate");
      }
    }

    document.getElementById("languageButton").addEventListener("click", () => {
      applyLanguage(currentLanguage === "ar" ? "en" : "ar");
    });

    document.querySelectorAll(".tab-button").forEach(button => {
      button.addEventListener("click", () => {
        document.querySelectorAll(".tab-button").forEach(item => item.classList.remove("active"));
        document.querySelectorAll(".converter-form").forEach(form => form.classList.remove("active"));
        button.classList.add("active");
        document.getElementById(button.dataset.tab).classList.add("active");
        lastConverterState = "select";
        document.getElementById("converterResult").textContent = t("selectDate");
      });
    });

    document.getElementById("gMonth").addEventListener("change", refreshGregorianDays);
    document.getElementById("gYear").addEventListener("change", refreshGregorianDays);

    document.getElementById("gToH").addEventListener("submit", async event => {
      event.preventDefault();
      const result = document.getElementById("converterResult");
      result.textContent = t("converting");

      try {
        const converted = await convertGregorianToHijri(
          document.getElementById("gDay").value,
          document.getElementById("gMonth").value,
          document.getElementById("gYear").value
        );
        renderConversionResult(converted.number, converted.text);
      } catch (error) {
        console.error(error);
        lastConverterState = "error";
        result.textContent = t("conversionUnavailable");
      }
    });

    document.getElementById("hToG").addEventListener("submit", async event => {
      event.preventDefault();
      const result = document.getElementById("converterResult");
      result.textContent = t("converting");

      try {
        const converted = await convertHijriToGregorian(
          document.getElementById("hDay").value,
          document.getElementById("hMonth").value,
          document.getElementById("hYear").value
        );
        renderConversionResult(converted.number, converted.text);
      } catch (error) {
        console.error(error);
        lastConverterState = "error";
        result.textContent = t("invalidHijri");
      }
    });

    const radioAudio = document.getElementById("radioAudio");
    const playButton = document.getElementById("playButton");
    const radioStatus = document.getElementById("radioStatus");

    function setRadioButton(playing) {
      playButton.innerHTML = playing
        ? '<i class="fa-solid fa-pause"></i>'
        : '<i class="fa-solid fa-play"></i>';
      playButton.setAttribute("aria-label", playing ? t("pauseAria") : t("playAria"));
    }

    playButton.addEventListener("click", async () => {
      if (!radioAudio.paused) {
        radioAudio.pause();
        return;
      }

      radioStatus.textContent = t("connecting");
      try {
        await radioAudio.play();
      } catch (error) {
        console.error(error);
        setRadioButton(false);
        radioStatus.textContent = t("streamUnavailable");
      }
    });

    radioAudio.addEventListener("playing", () => {
      setRadioButton(true);
      radioStatus.textContent = t("playing");
    });

    radioAudio.addEventListener("pause", () => {
      setRadioButton(false);
      radioStatus.textContent = t("paused");
    });

    radioAudio.addEventListener("waiting", () => {
      radioStatus.textContent = t("buffering");
    });

    radioAudio.addEventListener("error", () => {
      setRadioButton(false);
      radioStatus.textContent = t("streamUnavailable");
    });

    document.getElementById("shareButton").addEventListener("click", async () => {
      const shareData = {
        title: t("shareTitle"),
        text: t("shareText"),
        url: window.location.href
      };

      try {
        if (navigator.share) {
          await navigator.share(shareData);
        } else {
          await navigator.clipboard.writeText(window.location.href);
          radioStatus.textContent = t("copied");
        }
      } catch (error) {
        if (error.name !== "AbortError") {
          console.error(error);
          radioStatus.textContent = t("shareFailed");
        }
      }
    });

    document.addEventListener("DOMContentLoaded", () => {
      const { year, month, day } = makkahDateParts();
      const currentGregorianYear = Number(year);

      fillNumberSelect("gYear", 1900, 2100, currentGregorianYear);
      fillNumberSelect("gDay", 1, daysInGregorianMonth(year, month), Number(day));
      fillNumberSelect("hYear", 1300, 1600, 1448);
      fillNumberSelect("hDay", 1, 30, 19);

      fillMonthSelect("gMonth", translations[currentLanguage].gregorianMonths, Number(month));
      fillMonthSelect("hMonth", translations[currentLanguage].hijriMonths, 2);

      renderPrayerGrid();
      applyLanguage(currentLanguage);
      setInterval(updateMakkahClock, 1000);
      loadPrayerTimes();
    });
  </script>
</body>
</html>
