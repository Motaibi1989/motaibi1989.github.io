<!-- About Section -->
<section id="about">
<div class="container">
<div class="section-title">
        
<!-- 
<h2>About Me</h2>
<p>Enterprise integration specialist with a passion for automation and system optimization</p>
</div>
-->
        
<div class="about-content">
<div class="about-text fade-in">       
<h3>Hello, I'm Mohammed Alotaibi</h3>
<p>I'm a Senior Enterprise IT Integration Specialist with 10+ years of experience in enterprise integration, middleware engineering, Linux infrastructure, cloud platforms, and automation within aviation and enterprise IT environments.</p>
<p>I specialize in creating seamless integration solutions using IBM MQ, Azure Integration Services, APIs, and SFTP automation. My work focuses on reducing manual processes, improving system performance, and enabling digital transformation.</p>
<div class="skills">
<span class="skill">Enterprise Integration</span>
<span class="skill">IBM MQ</span>
<span class="skill">Azure</span>
<span class="skill">Linux</span>
<span class="skill">Shell Scripting</span>
<span class="skill">API Development</span>
<span class="skill">SFTP Automation</span>
<span class="skill">AMOS</span>
<span class="skill">Nginx</span>
<span class="skill">PowerShell</span>
<span class="skill">Python</span>
<span class="skill">Java</span>
</div>
</div>
</div>
</div>
</section>
<!-- Accounts Section - Left Aligned -->
<section class="bg-light" id="accounts">
<div class="container">
<div class="section-title">
<h2>My Accounts</h2>
<p>Connect with me across platforms</p>
</div>
<div class="accounts-grid">
<div class="account-card fade-in">
<div class="account-icon">
<i class="fab fa-github"></i>
</div>
<h3>GitHub</h3>
<p>Main GitHub account with various projects and contributions in shell scripting, Free Pascal, and enterprise automation.</p>
<a class="btn" href="https://github.com/Motaibi1989" target="_blank">Visit Profile</a>
</div>
<div class="account-card fade-in delay-1">
<div class="account-icon">
<i class="fas fa-terminal"></i>
</div>
<h3>ShellScript</h3>
<p>Repository dedicated to Shell Scripting projects, automation utilities, and system administration tools.</p>
<a class="btn" href="https://github.com/Motaibi1989/ShellScript" target="_blank">View Repository</a>
</div>
<div class="account-card fade-in delay-2">
<div class="account-icon">
<i class="fas fa-code"></i>
</div>
<h3>FreePascal</h3>
<p>Collection of Free Pascal projects, applications, and code examples using Lazarus IDE.</p>
<a class="btn" href="https://github.com/Motaibi1989/FreePascal" target="_blank">View Repository</a>
</div>
<div class="account-card fade-in delay-3">
<div class="account-icon">
<i class="fab fa-twitter"></i>
</div>
<h3>Twitter/X</h3>
<p>Follow me for tech updates, programming tips, and industry insights.</p>
<a class="btn" href="https://twitter.com/motaibi1989" target="_blank">Follow @motaibi1989</a>
</div>
<div class="account-card fade-in delay-4">
<div class="account-icon">
<i class="fab fa-stack-overflow"></i>
</div>
<h3>Stack Overflow</h3>
<p>View my technical questions, answers, and contributions to the developer community.</p>
<a class="btn" href="https://stackoverflow.com/users/3082739/motaibi1989" target="_blank">View Profile</a>
</div>
<div class="account-card fade-in delay-5">
<div class="account-icon">
<i class="fab fa-linkedin-in"></i>
</div>
<h3>LinkedIn</h3>
<p>Professional profile, work history, and network connections in enterprise IT.</p>
<a class="btn" href="https://www.linkedin.com/in/motaibi1989" target="_blank">Connect</a>
</div>
</div>
</div>
</section>
<!-- Projects Section -->
<section id="projects">
<div class="container">
<div class="section-title">
<h2>Featured Projects</h2>
<p>Audit-ready integration solutions</p>
</div>
