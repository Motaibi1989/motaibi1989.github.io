---
import SEO from '../components/SEO.astro';
import { navigation } from '../config/navigation.config';
const { page } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <SEO page={page} />
  </head>
  <body>
    <header>
      <nav aria-label="Primary">
        {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </header>
    <main><slot /></main>
    <footer>© Mohammed Alotaibi · motaibi1989.com</footer>
  </body>
</html>
<style is:global>
  :root { font-family: system-ui, sans-serif; line-height: 1.6; }
  body { max-width: 1100px; margin: 0 auto; padding: 1rem; }
  nav { display: flex; flex-wrap: wrap; gap: 1rem; padding: 1rem 0; }
  a { color: inherit; }
  .hero { padding: 4rem 0 2rem; }
  .chips { display: flex; flex-wrap: wrap; gap: .5rem; }
  .chip { border: 1px solid currentColor; border-radius: 999px; padding: .25rem .7rem; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; }
  .card { border: 1px solid #9996; border-radius: 1rem; padding: 1rem; }
  footer { margin-top: 4rem; padding: 2rem 0; border-top: 1px solid #9996; }
</style>
