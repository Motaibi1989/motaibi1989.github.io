<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Islamic Library - PDF Collection</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #1e3c3f 0%, #315d5f 100%);
            min-height: 100vh;
            padding: 2rem;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .header {
            text-align: center;
            color: white;
            margin-bottom: 3rem;
            padding: 2rem;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .header h1 {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            font-weight: 600;
        }

        .header p {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        .pdf-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 2rem;
            padding: 1rem;
        }

        .pdf-card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 2rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            transition: transform 0.3s, box-shadow 0.3s;
            display: flex;
            flex-direction: column;
            border: 1px solid rgba(255, 255, 255, 0.3);
            backdrop-filter: blur(5px);
        }

        .pdf-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
            background: white;
        }

        .pdf-icon {
            font-size: 4rem;
            text-align: center;
            margin-bottom: 1rem;
        }

        .pdf-title {
            font-size: 1.5rem;
            font-weight: 600;
            color: #1e3c3f;
            margin-bottom: 0.5rem;
            text-align: center;
            line-height: 1.3;
        }

        .pdf-title-arabic {
            font-size: 1.3rem;
            color: #2d5a5c;
            margin-bottom: 1rem;
            text-align: center;
            font-family: 'Traditional Arabic', 'Amiri', serif;
            direction: rtl;
        }

        .pdf-description {
            color: #4a5568;
            margin-bottom: 1.5rem;
            line-height: 1.6;
            flex-grow: 1;
            text-align: center;
        }

        .pdf-meta {
            background: #f0f7f8;
            padding: 1rem;
            border-radius: 10px;
            margin-bottom: 1.5rem;
            font-size: 0.9rem;
            color: #2c5f61;
            display: flex;
            justify-content: space-around;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .pdf-meta span {
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }

        .button-group {
            display: flex;
            gap: 1rem;
            justify-content: center;
        }

        .btn {
            padding: 0.8rem 1.5rem;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            flex: 1;
            justify-content: center;
        }

        .btn-read {
            background: #1e3c3f;
            color: white;
        }

        .btn-read:hover {
            background: #2d5a5c;
            transform: scale(1.05);
        }

        .btn-download {
            background: #2d5a5c;
            color: white;
        }

        .btn-download:hover {
            background: #1e3c3f;
            transform: scale(1.05);
        }

        .footer {
            text-align: center;
            margin-top: 3rem;
            color: white;
            font-size: 0.9rem;
            opacity: 0.8;
        }

        @media (max-width: 768px) {
            body {
                padding: 1rem;
            }

            .pdf-grid {
                grid-template-columns: 1fr;
            }

            .button-group {
                flex-direction: column;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>📚 Islamic Library Collection</h1>
            <p>Browse, read, or download authentic Islamic texts in multiple languages</p>
        </div>

        <div class="pdf-grid">
            <!-- Card 1: King Fahd Quran -->
            <div class="pdf-card">
                <div class="pdf-icon">📖</div>
                <div class="pdf-title">King Fahd Quran</div>
                <div class="pdf-title-arabic">مصحف الملك فهد</div>
                <div class="pdf-description">
                    The official Mushaf of the King Fahd Complex for the Printing of the Holy Quran in Medina. 
                    Features standard Uthmani script with clear, readable text. Perfect for daily recitation and study.
                </div>
                <div class="pdf-meta">
                    <span>📅 March 30, 2023</span>
                    <span>📊 95.3 MB</span>
                    <span>📄 PDF</span>
                </div>
                <div class="button-group">
                    <a href="#" class="btn btn-read" onclick="openPDF('1_King Fahd Quran_مصحف الملك فهد.pdf')">📖 Read</a>
                    <a href="#" class="btn btn-download" onclick="downloadPDF('1_King Fahd Quran_مصحف الملك فهد.pdf')">📥 Download</a>
                </div>
            </div>

            <!-- Card 2: Medina Quran -->
            <div class="pdf-card">
                <div class="pdf-icon">📗</div>
                <div class="pdf-title">Medina Quran</div>
                <div class="pdf-title-arabic">مصحف المدينة النبوية</div>
                <div class="pdf-description">
                    The renowned Medina Mushaf, published by the King Fahd Complex. 
                    Features beautiful calligraphy and includes Tajweed rules with color-coded letters for proper pronunciation.
                </div>
                <div class="pdf-meta">
                    <span>📅 March 30, 2023</span>
                    <span>📊 157.1 MB</span>
                    <span>📄 PDF</span>
                </div>
                <div class="button-group">
                    <a href="#" class="btn btn-read" onclick="openPDF('2_Medina Quran_مصحف المدينة النبوية.pdf')">📖 Read</a>
                    <a href="#" class="btn btn-download" onclick="downloadPDF('2_Medina Quran_مصحف المدينة النبوية.pdf')">📥 Download</a>
                </div>
            </div>

            <!-- Card 3: Holy Quran in all languages -->
            <div class="pdf-card">
                <div class="pdf-icon">🌍</div>
                <div class="pdf-title">The Holy Quran in All Languages</div>
                <div class="pdf-title-arabic">القرآن الكريم بجميع اللغات</div>
                <div class="pdf-description">
                    A comprehensive multilingual Quran with translations in multiple languages. 
                    Includes Arabic text alongside translations for easy reference and understanding.
                </div>
                <div class="pdf-meta">
                    <span>📅 March 30, 2023</span>
                    <span>📊 1.19 MB</span>
                    <span>📄 PDF</span>
                </div>
                <div class="button-group">
                    <a href="#" class="btn btn-read" onclick="openPDF('3_The Holy Quran in all languages_القرآن الكريم بجميع اللغات.pdf')">📖 Read</a>
                    <a href="#" class="btn btn-download" onclick="downloadPDF('3_The Holy Quran in all languages_القرآن الكريم بجميع اللغات.pdf')">📥 Download</a>
                </div>
            </div>

            <!-- Card 4: The Nuclear Forty -->
            <div class="pdf-card">
                <div class="pdf-icon">🕌</div>
                <div class="pdf-title">The Nuclear Forty</div>
                <div class="pdf-title-arabic">الأربعين النووية</div>
                <div class="pdf-description">
                    Imam Al-Nawawi's Forty Hadith - a collection of forty fundamental hadiths that summarize the core teachings of Islam. 
                    Includes Arabic text with commentary and explanations.
                </div>
                <div class="pdf-meta">
                    <span>📅 March 31, 2023</span>
                    <span>📊 583 KB</span>
                    <span>📄 PDF</span>
                </div>
                <div class="button-group">
                    <a href="#" class="btn btn-read" onclick="openPDF('4_The nuclear forty_الأربعين النووية.pdf')">📖 Read</a>
                    <a href="#" class="btn btn-download" onclick="downloadPDF('4_The nuclear forty_الأربعين النووية.pdf')">📥 Download</a>
                </div>
            </div>

            <!-- Card 5: Fortress of the Muslim -->
            <div class="pdf-card">
                <div class="pdf-icon">🛡️</div>
                <div class="pdf-title">Fortress of the Muslim</div>
                <div class="pdf-title-arabic">حصن المسلم</div>
                <div class="pdf-description">
                    A collection of authentic supplications (duas) and remembrances (adhkar) from the Quran and Sunnah. 
                    Essential daily prayers for protection and spiritual well-being.
                </div>
                <div class="pdf-meta">
                    <span>📅 March 30, 2023</span>
                    <span>📊 2.25 MB</span>
                    <span>📄 PDF</span>
                </div>
                <div class="button-group">
                    <a href="#" class="btn btn-read" onclick="openPDF('5_Fortress of the Muslim_حصن المسلم.pdf')">📖 Read</a>
                    <a href="#" class="btn btn-download" onclick="downloadPDF('5_Fortress of the Muslim_حصن المسلم.pdf')">📥 Download</a>
                </div>
            </div>
        </div>

        <div class="footer">
            <p>📜 All PDFs are sourced from authentic Islamic publications. May this knowledge benefit all.</p>
            <p style="margin-top: 0.5rem; font-size: 0.8rem;">Click "Read" to view in browser | Click "Download" to save to your device</p>
        </div>
    </div>

    <script>
        // Function to open PDF in new tab
        function openPDF(filename) {
            // You can serve PDFs from a specific directory
            // For local development, PDFs should be in the same folder as this HTML file
            window.open(filename, '_blank');
            return false;
        }

        // Function to download PDF
        function downloadPDF(filename) {
            // Create a temporary link element
            const link = document.createElement('a');
            link.href = filename;
            link.download = filename;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            return false;
        }

        // Add keyboard navigation and accessibility
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                // Optional: Close any open PDF viewers
                console.log('Escape pressed');
            }
        });

        // Add touch support for mobile devices
        if ('ontouchstart' in window) {
            document.body.classList.add('touch-device');
        }
    </script>
</body>
</html>


